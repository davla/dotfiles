#!/usr/bin/env sh

# This script installs actionlint to a system location. It is meant to be used
# via the gh-release command.
#
# Arguments:
#   - $1: The GitHub repository name the software is installed from
#   - $2: The GitHub release tag containing the artifacts to install
#
# {{@@ header() @@}}

set -e

#######################################
# Libraries includes
#######################################

. "{{@@ gh_release_path @@}}"

########################################
# Input processing
########################################

GITHUB_REPO="$1"
RELEASE_TAG="$2"

########################################
# Main
########################################

EXTRACT_DIR="$(mktemp --directory 'XXX.gh-release-actionlint.XXX')"
# shellcheck disable=SC2064
trap "rm --force --recursive $EXTRACT_DIR" EXIT HUP INT TERM

log_debug 'Download actionlint...'
RELEASE_ASSET_NAME="*linux*$(cpu_arch 'amd64').tar.gz"
gh --repo "$GITHUB_REPO" release download "$RELEASE_TAG" --output - \
        --pattern "$RELEASE_ASSET_NAME" \
    | tar --extract --gzip --directory "$EXTRACT_DIR"

log_debug 'Install actionlint executable'
install --mode 755 -D --target-directory '/usr/local/bin/' \
    "$EXTRACT_DIR/actionlint"

log_debug 'Install actionlint man pages'
for MAN_FILE in "$EXTRACT_DIR/man/"*; do
    PAGE="${MAN_FILE##*.}"
    install --mode 644 -D --target-directory "/usr/local/share/man/man$PAGE" \
        "$MAN_FILE"
done
mandb 2>&1 | log_debug
