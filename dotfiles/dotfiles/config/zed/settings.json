// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "active_pane_modifiers": { "inactive_opacity": 0.8 },
  "agent": {
    "button": false,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_ui_font_size": 16.0,
  "auto_indent_on_paste": false,
  "auto_install_extensions": {
    "desktop": true,
    "docker-compose": true,
    "dockerfile": true,
    "editorconfig": true,
    "emoji-completions": true,
    "html": true,
    "ini": true,
    "jinja2": true,
    "lua": true,
    "make": true,
    "symbols": true,
    "toml": true,
    "xml": true,
  },
  "auto_update": false,
  "autosave": "on_focus_change",
  "base_keymap": "VSCode",
  "bottom_dock_layout": "contained",
  "buffer_font_fallbacks": ["Symbols Nerd Font Mono", ".ZedMono"],
  "buffer_font_family": "DejaVu Sans Mono",
  "buffer_font_size": 16.0,
  "buffer_line_height": "comfortable",
  "cli_default_open_behavior": "new_window",
  "close_on_file_delete": true,
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "colorize_brackets": true,
  "completion_menu_item_kind": "symbol",
  "completion_menu_scrollbar": "auto",
  "completions": { "lsp_fetch_timeout_ms": 500 },
  "cursor_shape": "underline",
  "debugger": {
    "button": true,
    "dock": "left",
  },
  "default_open_behavior": "new_window",
  "diff_view_style": "unified",
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": false,
      "min_column": 0,
      "padding": 4,
    },
  },
  "double_click_in_multibuffer": "open",
  "drag_and_drop_selection": { "enabled": false },
  "ensure_final_newline_on_save": false,
  "excerpt_context_lines": 5,
  "expand_excerpt_lines": 10,
  "format_on_save": "on",
  "git": { "inline_blame": { "enabled": false } },
  "git_panel": {
    "button": false,
    "dock": "left",
    "file_icons": true,
  },
  "gutter": {
    "bookmarks": false,
    "breakpoints": true,
    "folds": true,
    "min_line_number_digits": 0,
    "runnables": false,
  },
  "hover_popover_hiding_delay": 0,
  "icon_theme": {
    "dark": "Symbols Icon Theme",
    "light": "Symbols Icon Theme",
    "mode": "system",
  },
  "indent_guides": { "coloring": "indent_aware" },
  "inlay_hints": { "show_type_hints": true },
  "inline_code_actions": false,
  "languages": {
    "YAML": { "formatter": "none" },
  },
  "lsp_document_colors": "none",
  "lsp_results_location": "picker",
  "markdown_preview": {
    "code_font_family": ".ZedMono",
    "font_family": ".ZedSans",
  },
  "middle_click_paste": false,
  "minimap": { "show": "never" },
  "on_last_window_closed": "quit_app",
  "outline_panel": {
    "button": false,
    "dock": "left",
  },
  "preview_tabs": {
    "enable_preview_from_project_panel": false,
    "enabled": false,
  },
  "prettier": { "allowed": true },
  "project_panel": {
    "bold_folder_labels": false,
    "button": true,
    "default_width": 300.0,
    "diagnostic_badges": true,
    "dock": "left",
    "drag_and_drop": false,
    "entry_spacing": "comfortable",
    "folder_indicator": "chevron",
    "git_status_indicator": false,
    "hide_hidden": false,
    "hide_root": true,
    "indent_size": 30.0,
  },
  "proxy": "",
  "scrollbar": { "show": "auto" },
  "search": { "button": false },
  "seed_search_query_from_cursor": "selection",
  "selection_highlight": false,
  "semantic_tokens": "combined",
  "show_signature_help_after_edits": false,
  "status_bar": {
    "active_encoding_button": "non_utf8",
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": true,
    "show_active_file": false,
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": false,
  },
  "tabs": {
    "activate_on_close": "left_neighbour",
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "show_close_button": "hover",
    "show_diagnostics": "all",
  },
  "terminal": { "button": false },
  "theme": {
    "dark": "Ayu Even Darker",
    "light": "One Light",
    "mode": "system",
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_branch_name": false,
    "show_branch_status_icon": false,
    "show_menus": false,
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_sign_in": false,
    "show_user_menu": false,
    "show_user_picture": false,
  },
  "toolbar": {
    "agent_review": true,
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": true,
  },
  "ui_font_size": 17.0,
  "unnecessary_code_fade": 0.3,
  "use_smartcase_search": true,
  "use_system_path_prompts": false,
  "use_system_prompts": false,
  "when_closing_with_no_tabs": "keep_window_open",
  "which_key": { "enabled": false },
  "window_decorations": "client",
  "wrap_guides": [79],
}
