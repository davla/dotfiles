#!/usr/bin/env bash

MOUSE_LAYER=''
TIMEOUT=3

while [ $# -gt 0 ]; do
    case "$1" in
        '--mouse-layer')
            MOUSE_LAYER="$2"
            shift
            ;;

        '--reset-timeout')
            TIMEOUT="$2"
            shift
            ;;
    esac
    shift
done

[ -z "$MOUSE_LAYER" ] && {
    echo >&2 'No --mouse-layer specified'
    exit 63
}

current_layer() {
    kontroll status --json | jq '.keyboard.current_layer'
}

bool() {
    if [ "$?" -eq 0 ]; then
        echo 'true'
    else
        echo 'false'
    fi
}

exit_auto_mouse() {
    [ "$(current_layer)" = "$MOUSE_LAYER" ] && \
        kontroll set-layer --index "$BEFORE_AUTO_MOUSE_LAYER"
    IN_AUTO_MOUSE='false'
}

BEFORE_AUTO_MOUSE_LAYER="$(current_layer)"
IN_AUTO_MOUSE='false'

evsieve $(printf -- '--input %s ' /dev/input/by-id/*event-mouse* /dev/input/by-id/*event-kbd*) --print \
    | while true; do
        if read -r -t "$TIMEOUT" HID_INPUT; then
            IS_KBD_INPUT="$(grep --quiet 'event-kbd' <<<"$HID_INPUT"; bool)"

            ! $IN_AUTO_MOUSE && $IS_KBD_INPUT && continue

            $IN_AUTO_MOUSE && {
                IS_MOUSE_BTN_INPUT="$(grep --extended-regexp --quiet \
                    'type:code = btn:.+value = 0 \(up\)' <<<"$HID_INPUT"; bool)"
                $IS_KBD_INPUT || $IS_MOUSE_BTN_INPUT && exit_auto_mouse
                continue
            }

            BEFORE_AUTO_MOUSE_LAYER="$(current_layer)"
            [ "$BEFORE_AUTO_MOUSE_LAYER" = "$MOUSE_LAYER" ] && continue

            kontroll set-layer --index "$MOUSE_LAYER"
            IN_AUTO_MOUSE='true'
        else
            ! $IN_AUTO_MOUSE && continue
            exit_auto_mouse
        fi
    done
