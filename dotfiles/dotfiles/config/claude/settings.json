{
  "awaySummaryEnabled": false,
  "env": {
    "CAVEMAN_DEFAULT_MODE": "ultracave"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "notion@claude-plugins-official": true,
    "spacelift@spacelift": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "spacelift": {
      "source": {
        "source": "github",
        "repo": "spacelift-io/claude-plugins"
      }
    }
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "sh $CLAUDE_CONFIG_DIR/statusline.sh"
  },
  "theme": "dark"
}
