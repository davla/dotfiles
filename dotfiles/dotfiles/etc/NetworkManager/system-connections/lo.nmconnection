# This file's only purpose is to set an alias to the loopback interface,
# for my work's local development setup

[connection]
id=lo
type=loopback
interface-name=lo

[loopback]

[ipv4]
address1=127.0.0.1/8
address2={{@@ local_penneo_addr @@}}/32
method=manual

[ipv6]
addr-gen-mode=default
address1=::1/128
method=manual

[proxy]
