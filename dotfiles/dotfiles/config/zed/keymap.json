// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor",
    "bindings": {
      "alt-a": "editor::SortLinesCaseSensitive",
      "alt-c": ["editor::ToggleComments", { "advance_downwards": false }],
      "alt-n": "editor::Rename",
      "alt-q": [
        "action::Sequence",
        ["editor::SelectInsideDelimiters", "editor::UnwrapSyntaxNode"],
      ],
      "ctrl-d": "editor::DuplicateLineDown",
      "ctrl-down": "editor::MoveLineDown",
      "ctrl-i": "editor::Indent",
      "ctrl-space": "editor::ShowCompletions",
      "ctrl-u": "editor::Outdent",
      "ctrl-up": "editor::MoveLineUp",
    },
    "unbind": {
      "ctrl-d": ["editor::SelectNext", { "replace_newest": false }],
      "ctrl-i": "editor::ShowSignatureHelp",
      "ctrl-u": "editor::UndoSelection",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "alt-left": "pane::ActivatePreviousItem",
      "alt-right": "pane::ActivateNextItem",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-j": "language_selector::Toggle",
      "ctrl-alt-f": "pane::DeploySearch",
      "ctrl-b": "project_panel::Toggle",
      "ctrl-e": "file_finder::Toggle",
      "ctrl-j": "project_panel::CollapseAllEntries",
      "ctrl-r": "project_symbols::Toggle",
    },
  },
  {
    "bindings": {
      "ctrl-p": "command_palette::Toggle",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "alt-d": "editor::GoToDefinition",
      "alt-d alt-d": [
        "editor::GoToDefinition",
        { "open_results_in": "multi_buffer" },
      ],
      "alt-i": "editor::GoToImplementation",
      "alt-i alt-i": [
        "editor::GoToImplementation",
        { "open_results_in": "multi_buffer" },
      ],
      "alt-l": "editor::GoToDeclaration",
      "alt-l alt-l": [
        "editor::GoToDeclaration",
        { "open_results_in": "multi_buffer" },
      ],
      "alt-r": "editor::FindAllReferences",
      "alt-r alt-r": [
        "editor::FindAllReferences",
        { "open_results_in": "multi_buffer" },
      ],
      "ctrl-shift-f": "text_finder::Toggle",
    },
    "unbind": {
      "ctrl-alt-f": "text_finder::Toggle",
    }
  },
  {
    "context": "TextFinder || (TextFinder > Picker > Editor) || (TextFinder > Picker > menu)",
    "bindings": {
      "ctrl-shift-f": "text_finder::ToProjectSearch",
    },
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "ctrl-shift-f": "text_finder::Toggle",
    },
    "unbind": {
      "ctrl-alt-f": "text_finder::Toggle",
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-alt-f": "buffer_search::Deploy",
    },
  },
]
